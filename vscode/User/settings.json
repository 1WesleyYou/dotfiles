{
  "files.autoSave": "afterDelay",
  "editor.fontSize": 14,
  "editor.fontFamily": "JetBrainsMono Nerd Font Mono",
  "editor.wordWrap": "on",
  "editor.fontLigatures": true,
  "workbench.colorTheme": "Catppuccin Mocha",
  "terminal.integrated.fontSize": 16,
  "terminal.integrated.fontFamily": "JetBrainsMono Nerd Font Mono",
  "[c]": {
    "editor.defaultFormatter": "xaver.clang-format",
  },
  "latex-workshop.formatting.latex": "tex-fmt",
  "makefile.configureOnOpen": true,
  "cpplint.cpplintPath": "/opt/homebrew/bin/cpplint",
  "workbench.iconTheme": "catppuccin-mocha",
  "[cpp]": {
    "editor.defaultFormatter": "xaver.clang-format",
  },
  "security.workspace.trust.untrustedFiles": "newWindow",
  "vim.useSystemClipboard": true,
  "vim.leader": "<space>",
  "vim.insertModeKeyBindings": [],
  "vim.insertModeKeyBindingsNonRecursive": [
    {
      "before": ["j", "k"],
      "after": ["<ESC>"],
    },
    // insert mode focus on terminal
    {
      "before": ["<C-j>"],
      "commands": ["workbench.action.terminal.focus"],
    },
    {
      "before": ["j", "j"],
      "after": ["<ESC>"],
    },
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.action.toggleSidebarVisibility"],
    },
    {
      "before": ["<leader>", "w"],
      "commands": ["workbench.file.save"],
    },
    {
      "before": ["<leader>", "q"],
      "commands": ["workbench.action.closeActiveEditor"],
    },
    {
      "before": ["<leader>", "h"],
      "commands": ["workbench.action.previousEditor"],
    },
    {
      "before": ["<leader>", "l"],
      "commands": ["workbench.action.nextEditor"],
    },
  ],
  "[jsonc]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "leetcode.endpoint": "leetcode-cn",
  "leetcode.workspaceFolder": "/Users/youyuchen/Desktop/leetcode",
  "leetcode.hint.commentDescription": false,
  "leetcode.defaultLanguage": "cpp",
  "clangd.fallbackFlags": ["-std=c++17"],
  "latex-workshop.message.error.show": false,
  "github.copilot.enable": {
    "*": true,
    "plaintext": true,
    "markdown": true,
    "scminput": false,
  },
  "claude-code.integration.enabled": true,
  "claude-code.diff.showInEditor": true,
  "claude-code.autoStart": true,
  // {
  //   "*": true,
  //   "plaintext": false,
  //   "markdown": true,
  //   "scminput": false
  // },
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorBlinking": "smooth",
  "terminal.integrated.cursorBlinking": true,
  "editor.cursorWidth": 1,
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.py": "default",
    "*.csv": "default",
  },
  "cmake.pinnedCommands": [
    "workbench.action.tasks.configureTaskRunner",
    "workbench.action.tasks.runTask",
  ],
  "cmake.showOptionsMovedNotification": false,
  "clangd.arguments": ["--compile-commands-dir=./build"],
  "C_Cpp.intelliSenseEngine": "disabled",
  "lldb.suppressUpdateNotifications": true,
  "git.confirmSync": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "editor.unicodeHighlight.invisibleCharacters": false,
  "containers.containerClient": "com.microsoft.visualstudio.containers.docker",
  "extensions.experimental.affinity": {
    "asvetliakov.vscode-neovim": 1,
  },
  "redhat.telemetry.enabled": false,
  "git.suggestSmartCommit": false,
  "docker.extension.enableComposeLanguageServer": false,
  "hediet.vscode-drawio.resizeImages": null,
  "hediet.vscode-drawio.theme": "kennedy",
  "hediet.vscode-drawio.appearance": "light",
  "terminal.integrated.commandsToSkipShell": ["matlab.interrupt"],
  "github.copilot.nextEditSuggestions.enabled": true,
  "MATLAB.installPath": "/Applications/MATLAB_R2024b.app",
  "vs-kubernetes": {
    "vscode-kubernetes.minikube-path-mac": "/Users/youyuchen/.vs-kubernetes/tools/minikube/darwin-arm64/minikube",
  },
  "terminal.integrated.fontLigatures.enabled": true,
  "remote.SSH.defaultExtensions": [
    "anthropic.claude-code",
    "mechatroner.rainbow-csv",
    "tamasfe.even-better-toml",
    "ms-pyright.pyright",
    "redhat.java",
    "vscjava.vscode-maven",
    "vscjava.vscode-java-test",
    "redhat.vscode-yaml",
    "redhat.vscode-xml",
    "ms-kubernetes-tools.vscode-kubernetes-tools",
    "vscjava.vscode-java-debug",
    "vscjava.vscode-java-dependency",
    "vscjava.vscode-java-pack",
    "vscode.ipynb",
    "aaron-bond.better-comments",
    "chrmarti.regex",
    "yzhang.markdown-all-in-one",
  ],
  "shellformat.path": "/usr/bin/shfmt",
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
  },
  "editor.inlayHints.padding": true,
  "[java]": {
    "editor.defaultFormatter": "redhat.java",
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "sqldeveloper.sqlHistory.historyLimit": 500,
  "sqldeveloper.telemetry.enabled": false,
  "[sql]": {
    "editor.defaultFormatter": "mtxr.sqltools",
  },
  "clang-format.fallbackStyle": "",
  "todohighlight.keywords": [
    "DEBUG:",
    "REVIEW:",
    {
      "text": "NOTE:",
      "color": "black",
      "italic": true,
      "backgroundColor": "#80deea",
      "overviewRulerColor": "grey",
    },
    {
      "text": "HACK:",
      "italic": true,
      "color": "black",
    },
    {
      "text": "TODO:",
      "italic": true,
      "color": "black",
      "backgroundColor": "#89ddff",
    },
    {
      "text": "FIXME:",
      "italic": true,
      "color": "black",
      "backgroundColor": "#f48fb1",
    },
    {
      "text": "INFO:",
      "italic": true,
      "color": "black",
      "backgroundColor": "#80cbc4",
    },
    {
      "text": "WARN:",
      "italic": true,
      "color": "black",
      "backgroundColor": "#ffe082",
    },
  ],
  // "todohighlight.keywordsPattern": "TODO:|FIXME:| |\\(([^)]+)\\)", //highlight `TODO:`,`FIXME:` or content between parentheses
  "todohighlight.defaultStyle": {
    "color": "black",
    "backgroundColor": "#89ddff",
    "overviewRulerColor": "blue",
    "fontWeight": "bold",
    "italic": true,
    "cursor": "pointer",
    "isWholeLine": false,
  },
  "github.copilot.chat.codesearch.enabled": true,
  "chat.editor.fontFamily": "JetBrainsMono Nerd Font Mono",
  "git.ignoreRebaseWarning": true,
  "chat.tools.terminal.autoApprove": {
    "make": true,
    "uv": true,
    "python": true,
    "./start_all.sh": true,
    "./status_all.sh": true,
    "pip": true,
    "ps": true,
    "python3": true,
    "git apply": true,
    "git submodule": true,
    "git ls-files": true,
    "sed": true,
    "awk": true,
    "FS": true,
    "printf": true,
    "find": true,
    "}": true,
    "ssh": true,
    "/dev/null": true,
    "go": true,
    "sha256sum": true,
    "strings": true,
    "true": true,
    "./zkbench": true,
    "bench_normal.log": true,
    "periodic_fetch\\.py)\"": true,
    "mkdir": true,
    "metrics/test_timestamp.txt": true,
    "./haproxy_runtime.sh": true,
    "git ls-remote": true,
    "git rev-parse": true,
    "uname": true,
    "id": true,
    "chmod": true,
    "agent/tools/zkctl/haproxy_runtime_summary.sh": true,
    "start_all.sh\"": true,
    "pgrep": true,
    "tools/zkctl/haproxy_runtime_summary.sh": true,
    "tools/zkctl/haproxy_get_frontend_stats.sh": true,
    "/workspace/CloudServer/.venv/bin/python": true,
    "ip": true,
    "whoami": true,
    "getent": true,
    "noglob": true,
    "setopt": true,
    "timeout": true,
    "/usr/bin/make": true,
    "./proxy_server": true,
    "/workspace/src/build/bench_transformer": true,
    "tee": true,
    "/^sudo \\./quick_test_single_frame\\.sh 2>&1 \\| head -100$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^\\./quick_test_single_frame\\.sh 2>&1 \\| tee /tmp/test_output\\.log$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^/opt/conda/bin/pip install transformers torch accelerate -q$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^/opt/conda/bin/python -c \"\nfrom huggingface_hub import HfApi\napi = HfApi\\(\\)\n\nprint\\('搜索 Qwen3 VLM 模型\\.\\.\\.'\\)\nprint\\(\\)\n\n# 搜索 Qwen3 相关模型\nmodels = api\\.list_models\\(search='Qwen3', limit=20, sort='downloads', direction=-1\\)\n\nqwen3_models = \\[\\]\nfor model in models:\n    if 'VL' in model\\.modelId or 'Vision' in model\\.modelId or 'vision' in model\\.modelId:\n        qwen3_models\\.append\\(model\\.modelId\\)\n        print\\(f'✓ \\{model\\.modelId\\}'\\)\n\nif not qwen3_models:\n    print\\('未找到 Qwen3 VLM 模型'\\)\n    print\\(\\)\n    print\\('搜索 Qwen2\\.5 VLM 模型作为参考:'\\)\n    models = api\\.list_models\\(search='Qwen2\\.5-VL', limit=10, sort='downloads', direction=-1\\)\n    for model in models:\n        print\\(f'  • \\{model\\.modelId\\}'\\)\n\"$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "/^\\./start_server_qwen3\\.sh 2>&1 \\| head -100$/": {
      "approve": true,
      "matchCommandLine": true,
    },
    "cp": true,
  },
  "clang-format.language.java.enable": false,
  "[dockercompose]": {
    "editor.insertSpaces": true,
    "editor.tabSize": 2,
    "editor.autoIndent": "advanced",
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "[github-actions-workflow]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
  },
  "python.analysis.typeCheckingMode": "standard",
  "[javascript]": {
    "editor.defaultFormatter": "vscode.typescript-language-features",
  },
  "files.associations": {
    "cu": "cpp",
  },
  "chat.mcp.gallery.enabled": true,
  "[html]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
  },
  "claudeCode.preferredLocation": "panel",
  "claudeCodeChat.thinking.intensity": "think-harder",
  "sqldeveloper.datagrid.fontFamily": "Menlo, Monaco, 'Courier New', monospace",
  "claudeCode.initialPermissionMode": "acceptEdits",
  "claudeCode.allowDangerouslySkipPermissions": true,
}
