        {
            "tag": "BUG:",
            "color": "#ffffff",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "#ff6b9d",
            "bold": true
        },
        {
            "tag": "FIXME:",
            "color": "#ffffff",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "#ff8fa3",
            "bold": true
        },
        {
            "tag": "TODO:",
            "color": "#000000",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "#5ccfe6",
            "bold": true
        },
        {
            "tag": "NOTE:",
            "color": "#000000",
            "strikethrough": false,
            "underline": false,
