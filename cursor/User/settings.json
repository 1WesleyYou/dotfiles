    "better-comments.highlightPlainText": false,
    "todo-tree.general.tags": [
        " TODO:",
        " FIXME:",
        " BUG:",
        " HACK:",
        " NOTE:",
        " INFO:",
        " TEST:",
        " WARN:"
    ],
    "todo-tree.regex.regex": "(//|#|<!--|;|/\\*|^|^[ \\t]*(-|\\d+.))($TAGS)",
    "todo-tree.highlights.defaultHighlight": {
        "type": "tag-and-comment",
        "gutterIcon": true
    },
    "todo-tree.highlights.customHighlight": {
