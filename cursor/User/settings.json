            "backgroundColor": "#7ee787",
            "bold": true
        },
        {
            "tag": "TEST:",
            "color": "#000000",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "#7ee8cf",
            "bold": true
        },
        {
            "tag": "HACK:",
            "color": "#000000",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "#ffa657",
            "bold": true
        },
        {
            "tag": "WARN:",
            "color": "#000000",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "#ffd93d",
            "bold": true
        },
        {
            "tag": "!",
            "color": "#ff6b6b",
            "strikethrough": false,
            "underline": false,
            "backgroundColor": "transparent",
            "bold": true
